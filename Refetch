name: Re-fetch All FOMC Statements

# Re-downloads every statement since 2006 with the current extractor and
# re-derives every rate. Run this after a parser fix. Takes about 10 minutes.
#
# HOW TO RUN:
#   Actions tab -> "Re-fetch All FOMC Statements" -> Run workflow
#
# In the log, check the "Rate check" line near the end: it should say 0 mismatch(es).

on:
  workflow_dispatch:

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true

permissions:
  contents: write

jobs:
  refetch:
    runs-on: ubuntu-24.04

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: pip install requests beautifulsoup4

      - name: Re-fetch every statement
        run: python update_statements.py --refetch

      - name: Commit and push updated files
        run: |
          git config user.name  "FOMC Tracker Bot"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add index.html 2>/dev/null || true
          git add statements.json 2>/dev/null || true
          git diff --cached --quiet \
            && echo "No changes to commit." \
            || (git commit -m "Re-fetch all FOMC statements with fixed extractor" && git push)
